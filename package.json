{
  "name": "groundstate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "node scripts/build-cf.mjs",
    "verify:publications": "tsx scripts/verify-publications.ts",
    "check:publication-diff": "tsx scripts/check-publication-diff.ts",
    "check:content": "tsx scripts/check-content.ts",
    "preflight": "node scripts/preflight.mjs && tsx scripts/check-content.ts",
    "build:production": "npm run preflight && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/fixture-build.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.20.4",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
