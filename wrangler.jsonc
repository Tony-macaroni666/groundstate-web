{
  // Cloudflare Workers Static Assets.
  //
  // Cloudflare builds this on every push (Workers Builds; root directory: the
  // repository root; build command `npm run build:cf`). The build writes the
  // whole site to ./out as real files and this config serves that directory.
  // Every page — including each published article, copied in byte for byte — is
  // a file on disk, served by the assets layer directly.
  //
  // The one exception is /api/* (run_worker_first below): worker/index.ts, which
  // today handles only POST /api/contact. No other request reaches the script.
  //
  // Only main is built and deployed. Builds for non-production branches are OFF
  // in the dashboard (docs/SETUP.md): a branch build runs that branch's own code
  // with the Cloudflare deploy token, so any pushed branch could otherwise deploy
  // over the live site without going through main's protection.
  //
  // NOT SET HERE: `routes`. The custom domain is attached in the dashboard
  // (docs/SETUP.md) and a deploy leaves it alone. PRODUCTION_ORIGIN in
  // scripts/build-cf.mjs must name the same origin and is set in the same step —
  // the two disagreeing is how a site ends up with canonical tags pointing at
  // somewhere it is not.
  "name": "ground-state",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Serves /research from research.html and /research/ alike, so the clean URL
    // works whichever way it is linked.
    "html_handling": "auto-trailing-slash",
    // Next writes 404.html; serve it with a 404 status rather than a redirect.
    "not_found_handling": "404-page"
  },
  // No per-version preview URLs: an old version would otherwise stay reachable
  // at an address of its own, including one serving an article since withdrawn.
  "preview_urls": false,
  // The site has one address, https://groundstatemethod.com (the custom domain
  // attached in the dashboard). No second copy on *.workers.dev.
  "workers_dev": false,
  // Workers Logs: the contact route logs one line per request — status and a
  // one-word reason, never message content. Pages and articles never run here.
  "observability": { "enabled": true },
  // The contact channel's mail. It can only send from the one address below, and
  // only to an address verified in Email Routing; which one is the secret
  // CONTACT_RECIPIENT, set in the dashboard with TURNSTILE_SECRET (docs/SETUP.md).
  "send_email": [
    { "name": "CONTACT_EMAIL", "allowed_sender_addresses": ["contact@groundstatemethod.com"] }
  ]
}
